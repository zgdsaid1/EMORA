{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMORA Internal Machine Contract v1",
  "description": "Internal language-neutral EMORA machine-consumption contract. Version 1.0.0 is the fixed implementation target; it is not frozen or publicly exposed until governance and validation gates pass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "result", "provenance", "disclosure"],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emotionVector", "dimensions", "stateId", "eventId", "timestamp"],
      "properties": {
        "emotionVector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["love", "fear", "nostalgia", "jealousy", "trust", "anger", "joy"],
          "properties": {
            "love": { "type": "number", "minimum": 0, "maximum": 1 },
            "fear": { "type": "number", "minimum": 0, "maximum": 1 },
            "nostalgia": { "type": "number", "minimum": 0, "maximum": 1 },
            "jealousy": { "type": "number", "minimum": 0, "maximum": 1 },
            "trust": { "type": "number", "minimum": 0, "maximum": 1 },
            "anger": { "type": "number", "minimum": 0, "maximum": 1 },
            "joy": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valence", "arousal", "intensity"],
          "properties": {
            "valence": { "type": "number", "minimum": -1, "maximum": 1 },
            "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "stateId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "description": "Canonical UTC ISO 8601 timestamp with exactly three fractional-second digits, as emitted by Date.prototype.toISOString()."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelIdentity", "parameterIdentity"],
      "properties": {
        "modelIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelVersionId", "name", "version"],
          "properties": {
            "modelVersionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "parameterIdentity": {
          "const": "DEFAULT_DETERMINISTIC_MODEL_PARAMETERS"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "text"],
      "properties": {
        "code": {
          "const": "COMPUTATIONAL_MODEL_ESTIMATED_STATE_NOT_HUMAN_MEASUREMENT"
        },
        "text": {
          "const": "EMORA output is a computational, model-estimated emotional state derived from the event and context you supplied, using EMORA's deterministic model. It is not a measurement of a person's true emotional state. It is not a detection of a person's true emotional state. It is not a diagnosis. It is not a clinical assessment. It does not establish psychological validity, and it must not be used as evidence of what a person actually feels."
        }
      }
    }
  }
}